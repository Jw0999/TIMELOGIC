# ── TimeLogic Web (Super Admin) — PRODUCTION env ─────────────────────────────
# Set these in your static host (Vercel/Netlify/Cloudflare) build settings, or
# copy to web/.env.production locally before `npm run build`.

# Full API base URL of the hosted backend, INCLUDING the /api suffix.
VITE_API_URL=https://api.yourdomain.com/api

# Optional. Backend origin for Socket.IO + /uploads images. If omitted it is
# derived automatically from VITE_API_URL (strips the trailing /api).
# VITE_SOCKET_URL=https://api.yourdomain.com
