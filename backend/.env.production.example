# ── TimeLogic Backend — PRODUCTION env ───────────────────────────────────────
# Copy to your host's environment (Render/Railway dashboard, or a .env on a VPS).
# NEVER commit real secrets. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=5000

# Managed Postgres connection string (Neon / Supabase / Render / Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# Managed Redis (Upstash / Render / Railway). Required: challenge codes, rate
# limiting and live presence all use it.
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# Auth secrets — generate fresh, long, random values (do NOT reuse dev ones)
JWT_ACCESS_SECRET="CHANGE_ME_64_HEX"
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_64_HEX"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR signing key — generate fresh
QR_SECRET_KEY="CHANGE_ME_64_HEX"
QR_DEFAULT_ROTATION_SECONDS=30

# Session automation windows (minutes) — defaults match the product spec
SESSION_LEAD_MIN=30
AUTO_CREATE_LEAD_MIN=10
CHECKIN_WINDOW_MIN=40
AUTO_CHECKOUT_LAG_MIN=40

# Uploaded face photos. Point this at a PERSISTENT disk mounted on the host,
# otherwise images are wiped on every redeploy. Absolute path is supported.
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=5

BCRYPT_ROUNDS=12

# Comma-separated list of the deployed frontends allowed to call the API.
# Include your web (super admin) origin. Desktop (Electron) and mobile do not
# need CORS, but if the desktop dev-serves from a localhost origin add it too.
CORS_ORIGINS=https://app.yourdomain.com

# Optional — email + push. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
FCM_SERVER_KEY=
