# ── TimeLogic Mobile (Employee, Expo) — PRODUCTION env ───────────────────────
# Expo reads EXPO_PUBLIC_* at build time. Set this for EAS builds (eas.json env,
# or a local .env consumed by `eas build`).

# Full API base URL of the hosted backend, INCLUDING the /api suffix.
# When set, the app uses this instead of the dev LAN-IP auto-detection.
EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
