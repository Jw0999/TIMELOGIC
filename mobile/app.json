{
  "expo": {
    "name": "TimeLogic",
    "slug": "attendance-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1D4ED8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.attendance.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TimeLogic needs your location to verify you are on the office WiFi network for check-in.",
        "NSLocationAlwaysUsageDescription": "TimeLogic needs your location to verify your office WiFi during attendance check-in.",
        "UIBackgroundModes": [
          "fetch"
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.attendance.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendance to access your camera for check-in verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Attendance to access your camera for selfie verification."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d6d5b887-5b49-40ef-be01-857fde124fa1"
      }
    },
    "owner": "fishgfgu"
  }
}
