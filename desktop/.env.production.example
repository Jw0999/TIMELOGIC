# ── TimeLogic Desktop (Admin, Electron) — PRODUCTION env ─────────────────────
# Copy to desktop/.env.production before building the renderer (`vite build`),
# then package with electron-builder. The value is baked into the build.

# Full API base URL of the hosted backend, INCLUDING the /api suffix.
VITE_API_URL=https://api.yourdomain.com/api

# Optional. Backend origin for Socket.IO + face-photo images. Derived from
# VITE_API_URL when omitted.
# VITE_SOCKET_URL=https://api.yourdomain.com
